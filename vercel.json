{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai-chat.ts": {
      "maxDuration": 300
    },
    "api/chatbot.ts": {
      "maxDuration": 60
    },
    "api/agent.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}